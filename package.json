{
  "name": "department-of-human-verification",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:eyetracking": "playwright test -c playwright.eyetracking.config.ts",
    "validate:stimuli": "node scripts/validate-stimuli.mjs",
    "check": "tsc --noEmit && node scripts/validate-stimuli.mjs && vitest run && vite build && bash scripts/check-public-build.sh dist && bash scripts/validate-prompts.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "webgazer": "3.5.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
